global packed: struct Packed align 8 init %6
  bytes [01 02 00 00 00 00 00 00 03 00 00 00 00 00 00 00]
global two: struct Two align 2 init %13
  bytes [01 00 00 00 00 00 00 00 00 40 2f 00 00 00 00 00]
global one: struct One align 1 init %18
