function @use(i32 %a0) -> i32 : int (int)
  slot s0: 4 bytes align 4 (i)
bb1:
  %1 = alloca s0 (i)
  store i32 %a0, %1, align 4
  %3 = tls_addr @tls
  %4 = load i32, %1, align 4
  %5 = load i32, %3, align 4
  %6 = add i32 %5, %4
  store i32 %6, %3, align 4
  store ptr @printf, @hook, align 8
  %9 = load ptr, @hook, align 8
  %10 = load i32, %1, align 4
  %11 = and i32 %10, 1
  %12 = sext i32 %11 to i64
  %13 = mul i64 %12, 8
  %14 = ptradd @names, %13
  %15 = load ptr, %14, align 8
  %16 = call i32 @next() : int (void)
  %17 = call i32 %9(ptr @.str, ptr %15, i32 %16) : int (const char *, ...)
  %18 = load i32, @ext, align 4
  %19 = tls_addr @tls
  %20 = load i32, %19, align 4
  %21 = add i32 %18, %20
  %22 = add i32 %21, 16
  ret i32 %22
function @next() -> i32 internal : int (void)
bb1:
  %1 = load i32, @next.calls, align 4
  %2 = add i32 %1, 1
  store i32 %2, @next.calls, align 4
  %4 = load i32, @counter, align 4
  %5 = add i32 %2, %4
  ret i32 %5
object @counter: int size 4 align 4
  bytes [03 00 00 00]
object @tls: int size 4 align 4 thread_local tentative
  bytes [00 00 00 00]
object @hook: int (*)(const char *, ...) size 8 align 8 tentative
  bytes [00 00 00 00 00 00 00 00]
object @.str: const char [7] size 7 align 1 internal constant
